{
  "name": "verbatim",
  "version": "1.0.0",
  "private": true,
  "description": "Verbatim — Every word, on your machine. Local-first media-to-text workstation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:web": "vite build --configLoader native --config web/vite.config.js",
    "web:dev": "vite --configLoader native --config web/vite.config.js",
    "web:build": "vite build --configLoader native --config web/vite.config.js",
    "web:preview": "vite preview --configLoader native --config web/vite.config.js --port 4173",
    "extension:build": "node extension/build.mjs",
    "extension:check": "node node_modules/typescript/bin/tsc -p extension/tsconfig.json",
    "services:install": "python scripts/setup_services.py",
    "services:test": "python -m pytest services/tests -q",
    "smoke": "python scripts/smoke_test.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.2.5",
    "@types/chrome": "^0.0.304",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "^8.5.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
